{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "nexus": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.css"],
            "assets": [{"glob": "**/*", "input": "public"}],
            "outputPath": "dist/nexus"
          },
          "configurations": {
            "production": {"outputHashing": "all", "optimization": {"scripts": true, "styles": {"minify": true, "inlineCritical": true}, "fonts": false}, "budgets": [{"type": "initial", "maximumWarning": "3MB", "maximumError": "5MB"}]}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"buildTarget": "nexus:build", "proxyConfig": "proxy.conf.json"}
        }
      }
    }
  }
}