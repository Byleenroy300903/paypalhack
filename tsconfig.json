{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "strict": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": false,
    "outDir": "./dist/out-tsc"
  },
  "angularCompilerOptions": {"strictTemplates": true},
  "include": ["src/**/*.ts"]
}