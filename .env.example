DATABASE_URL=sqlite:///./nexus.db
# Vercel sets VERCEL=1 automatically. Use a managed PostgreSQL URL there:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Frontend Vercel build setting (public URL only; never put secrets here):
# NEXUS_API_URL=https://YOUR-BACKEND.vercel.app
STEP_DELAY=1
PUBLIC_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Ollama Cloud negotiation. Configured failures stop the run, never substitute a demo offer.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT=90

# Optional: external event indexing; workflow data stays in SQL.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# PayPal sandbox checkout; no live-money endpoint exists in this project.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional operator override. Browser checkout uses a per-run, 24-hour capability instead.
SANDBOX_API_TOKEN=